import cv2
import numpy as np

# Read image from your path
image = cv2.imread(r"C:\Users\bhanu\OneDrive\Pictures\Saved Pictures\The divine Roar.jpg")

if image is None:
    print("Error: Image not found.")
else:
    # Resize image to smaller size
    image = cv2.resize(image, (200, 250))

    # Convert to grayscale
    gray_image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    # Create kernel
    kernel = np.ones((5,5), np.uint8)

    # Apply morphological closing
    closed_image = cv2.morphologyEx(gray_image, cv2.MORPH_CLOSE, kernel)

    # Display images
    cv2.imshow('Original Image', image)
    cv2.imshow('Closed Image', closed_image)

    cv2.waitKey(0)
    cv2.destroyAllWindows()
