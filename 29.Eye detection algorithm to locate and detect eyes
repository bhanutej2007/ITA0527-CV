import cv2

# Load Haar cascades
face_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
)

eye_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_eye.xml"
)

# Read image
image = cv2.imread(r"C:\Users\bhanu\OneDrive\Pictures\eyedetect.webp")

if image is None:
    print("Image not found")
    exit()

# Make frame smaller
image = cv2.resize(image, None, fx=0.6, fy=0.6)

gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

# Detect faces
faces = face_cascade.detectMultiScale(gray, 1.3, 5)

for (x, y, w, h) in faces:

    face_gray = gray[y:y + h//2, x:x+w]
    face_color = image[y:y + h//2, x:x+w]

    # Detect eyes
    eyes = eye_cascade.detectMultiScale(face_gray, 1.1, 5)

    for (ex, ey, ew, eh) in eyes:
        cv2.rectangle(face_color, (ex, ey), (ex+ew, ey+eh), (255,0,0), 2)

cv2.imshow("Eye Detection", image)

cv2.waitKey(0)
cv2.destroyAllWindows()
